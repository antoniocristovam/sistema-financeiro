# =============================================================================
# finapp - variaveis de ambiente (copie para .env)
# =============================================================================

NODE_ENV=development
TZ=UTC

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=finapp
POSTGRES_PASSWORD=finapp
POSTGRES_DB=finapp
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

DATABASE_URL="postgresql://finapp:finapp@localhost:5432/finapp?schema=public"
DATABASE_URL_TEST="postgresql://finapp:finapp@localhost:5433/finapp_test?schema=public"

# --- API --------------------------------------------------------------------
API_PORT=3333
API_URL=http://localhost:3333
WEB_URL=http://localhost:5173

# --- Auth -------------------------------------------------------------------
# Troque em qualquer ambiente que nao seja o seu localhost.
JWT_SECRET=dev-only-change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=finapp
MINIO_ROOT_PASSWORD=finapp123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=finapp
MINIO_SECRET_KEY=finapp123
MINIO_BUCKET_ATTACHMENTS=finapp-attachments
MINIO_BUCKET_EXPORTS=finapp-exports
MINIO_BUCKET_IMPORTS=finapp-imports
# TTL das presigned URLs de exportacao (24h)
EXPORT_URL_TTL_SECONDS=86400

# --- E-mail (Mailpit em dev) ------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="finapp <nao-responda@finapp.local>"

# --- Web (Vite) -------------------------------------------------------------
VITE_API_URL=http://localhost:3333
