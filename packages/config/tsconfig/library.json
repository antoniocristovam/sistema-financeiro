{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "finapp library (CJS + d.ts)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    // Ver o comentario em node.json: o .tsbuildinfo tem que morrer junto com o dist.
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  }
}
