{
  "name": "finapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "pnpm --filter @finapp/api db:generate",
    "db:migrate": "pnpm --filter @finapp/api db:migrate",
    "db:deploy": "pnpm --filter @finapp/api db:deploy",
    "db:reset": "pnpm --filter @finapp/api db:reset",
    "db:seed": "pnpm --filter @finapp/api db:seed",
    "db:seed:dev": "pnpm --filter @finapp/api db:seed:dev",
    "db:studio": "pnpm --filter @finapp/api db:studio",
    "setup": "pnpm install && pnpm infra:up && pnpm db:deploy && pnpm db:seed"
  },
  "devDependencies": {
    "@finapp/config": "workspace:*",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
